  "keyFeatures": [
    "RAG-powered question generation grounded in resume and job description context",
    "Real-time streaming interview feedback via Socket.io and Groq Llama 3.3",
    "AI resume parsing — extracts skills, experience, projects, and education",
    "Per-answer scoring and final interview report with strengths, weaknesses, and improvement tips",
    "AI job recommendations matched against parsed resume skills",
    "Live job board powered by Adzuna API with Redis caching",
    "JWT-based authentication with access/refresh token rotation",
    "Cloudinary-backed resume file storage",
    "Admin dashboard with user management, prompt editing, analytics, and scraper control",
    "Role-based access control (admin / super_admin)"
  ],
